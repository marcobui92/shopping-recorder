# Server listener and HTTP settings.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
# Set true only when the API is behind a trusted reverse proxy that overwrites forwarding headers.
TRUST_PROXY=false

# Required only by `npm run migrate`. Do not use real credentials here.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/shopping_recorder

# Optional private Backblaze B2 storage, accessed through its S3-compatible API.
# Use a bucket-scoped application key with read/write/delete access. Do not use the master application key.
# B2_APPLICATION_KEY_ID maps to the S3 access key ID; B2_APPLICATION_KEY maps to the S3 secret access key.
B2_REGION=us-west-004
B2_BUCKET_NAME=shopping-recorder-media
B2_APPLICATION_KEY_ID=replace-with-b2-key-id
B2_APPLICATION_KEY=replace-with-b2-application-key
B2_UPLOAD_EXPIRES_SECONDS=900
B2_DOWNLOAD_EXPIRES_SECONDS=300
B2_MAX_IMAGE_BYTES=26214400
B2_MAX_VIDEO_BYTES=524288000

# Optional Google Drive storage linking (Drive-only OAuth, scope drive.file).
# GOOGLE_TOKEN_ENCRYPTION_KEY must be a base64-encoded 32-byte random key.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/google-drive/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key
GOOGLE_OAUTH_STATE_TTL_SECONDS=600

# Keep the bucket private. Its browser CORS policy must allow the configured CORS_ORIGIN,
# PUT, and: Content-Type, x-amz-meta-activity-id, x-amz-meta-asset-id.
